root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{java,md}]
indent_style = tab
indent_size = 4
trim_trailing_whitespace = true

[*.{cjs,css,html,js,json,scss,ts}]
indent_style = tab
indent_size = 4
trim_trailing_whitespace = true

[package.json]
indent_style = space
indent_size = 2
