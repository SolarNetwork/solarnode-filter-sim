<?xml version="1.0" encoding="UTF-8"?>
<!--
 The blueprint of the custom filter bundle for the custom filter tests, written
 the way the SolarNode filter bundles write theirs.
-->
<blueprint xmlns="http://www.osgi.org/xmlns/blueprint/v1.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:osgix="http://www.eclipse.org/gemini/blueprint/schema/blueprint-compendium"
	xmlns:beans="http://www.springframework.org/schema/beans"
	xsi:schemaLocation="
		http://www.osgi.org/xmlns/blueprint/v1.0.0
		http://www.osgi.org/xmlns/blueprint/v1.0.0/blueprint.xsd
		http://www.eclipse.org/gemini/blueprint/schema/blueprint-compendium
		http://www.eclipse.org/gemini/blueprint/schema/blueprint-compendium/gemini-blueprint-compendium.xsd
		http://www.springframework.org/schema/beans
		http://www.springframework.org/schema/beans/spring-beans-4.2.xsd">

	<reference id="opModesService" interface="net.solarnetwork.node.service.OperationalModesService"/>

	<reference id="transientSettingDao" interface="net.solarnetwork.node.dao.TransientSettingDao"/>

	<reference id="executor" interface="java.util.concurrent.Executor" filter="(function=node)"/>

	<reference id="identityService" interface="net.solarnetwork.node.service.IdentityService"/>

	<bean id="datumQueue" class="net.solarnetwork.common.osgi.service.DynamicServiceTracker">
		<argument ref="bundleContext"/>
		<property name="serviceClassName" value="net.solarnetwork.node.service.DatumQueue"/>
		<property name="sticky" value="true"/>
	</bean>

	<!--
	 !!! Scale filter
	 -->

	<bean id="scaleMessageSource" class="org.springframework.context.support.ResourceBundleMessageSource">
		<property name="basenames">
			<array>
				<value>com.example.solarnode.filter.ScaleDatumFilterService</value>
				<value>net.solarnetwork.node.service.support.BaseDatumFilterSupport</value>
				<value>net.solarnetwork.service.support.BasicIdentifiable</value>
			</array>
		</property>
	</bean>

	<service interface="net.solarnetwork.settings.SettingSpecifierProviderFactory">
		<service-properties>
			<entry key="role">
				<array value-type="java.lang.String">
					<value>user</value>
					<value>datum-filter</value>
				</array>
			</entry>
		</service-properties>
		<bean class="net.solarnetwork.settings.support.BasicSettingSpecifierProviderFactory">
			<property name="displayName" value="Scale Datum Filter"/>
			<property name="factoryUid" value="com.example.solarnode.filter.scale"/>
			<property name="messageSource" ref="scaleMessageSource"/>
		</bean>
	</service>

	<osgix:managed-service-factory factory-pid="com.example.solarnode.filter.scale" autowire-on-update="true">
		<osgix:interfaces>
			<beans:value>net.solarnetwork.service.DatumFilterService</beans:value>
			<beans:value>net.solarnetwork.settings.SettingSpecifierProvider</beans:value>
		</osgix:interfaces>
		<osgix:service-properties>
			<beans:entry key="settingPid" value="com.example.solarnode.filter.scale"/>
			<beans:entry key="role">
				<beans:array value-type="java.lang.String">
					<beans:value>user</beans:value>
					<beans:value>datum-filter</beans:value>
				</beans:array>
			</beans:entry>
		</osgix:service-properties>
		<bean class="com.example.solarnode.filter.ScaleDatumFilterService"
				init-method="startup" destroy-method="shutdown">
			<argument ref="datumQueue"/>
			<property name="messageSource" ref="scaleMessageSource"/>
			<property name="opModesService" ref="opModesService"/>
			<property name="transientSettingDao" ref="transientSettingDao"/>
			<property name="executor" ref="executor"/>
			<property name="factor" value="2"/>
		</bean>
	</osgix:managed-service-factory>

	<!--
	 !!! Identity filter, which needs a service the simulator does not provide
	 -->

	<service interface="net.solarnetwork.settings.SettingSpecifierProviderFactory">
		<service-properties>
			<entry key="role">
				<array value-type="java.lang.String">
					<value>user</value>
					<value>datum-filter</value>
				</array>
			</entry>
		</service-properties>
		<bean class="net.solarnetwork.settings.support.BasicSettingSpecifierProviderFactory">
			<property name="displayName" value="Identity Datum Filter"/>
			<property name="factoryUid" value="com.example.solarnode.filter.identity"/>
			<property name="messageSource" ref="scaleMessageSource"/>
		</bean>
	</service>

	<osgix:managed-service-factory factory-pid="com.example.solarnode.filter.identity" autowire-on-update="true">
		<osgix:interfaces>
			<beans:value>net.solarnetwork.service.DatumFilterService</beans:value>
		</osgix:interfaces>
		<osgix:service-properties>
			<beans:entry key="role">
				<beans:array value-type="java.lang.String">
					<beans:value>user</beans:value>
					<beans:value>datum-filter</beans:value>
				</beans:array>
			</beans:entry>
		</osgix:service-properties>
		<bean class="com.example.solarnode.filter.IdentityDatumFilterService">
			<argument ref="identityService"/>
		</bean>
	</osgix:managed-service-factory>

	<!--
	 !!! Counter datum source
	 -->

	<bean id="placeholderService" class="net.solarnetwork.common.osgi.service.DynamicServiceTracker">
		<argument ref="bundleContext"/>
		<property name="serviceClassName" value="net.solarnetwork.node.service.PlaceholderService"/>
		<property name="sticky" value="true"/>
	</bean>

	<bean id="datumMetadataService" class="net.solarnetwork.common.osgi.service.DynamicServiceTracker">
		<argument ref="bundleContext"/>
		<property name="serviceClassName" value="net.solarnetwork.node.service.DatumMetadataService"/>
		<property name="sticky" value="true"/>
	</bean>

	<bean id="counterMessageSource" class="org.springframework.context.support.ResourceBundleMessageSource">
		<property name="basenames">
			<list>
				<value>com.example.solarnode.filter.CounterDatumDataSource</value>
				<value>net.solarnetwork.node.service.support.DatumDataSourceSupport</value>
				<value>net.solarnetwork.service.support.BasicIdentifiable</value>
			</list>
		</property>
	</bean>

	<bean id="counterJobMessageSource" class="net.solarnetwork.support.PrefixedMessageSource">
		<property name="prefix" value="datumDataSource."/>
		<property name="delegate" ref="counterMessageSource"/>
	</bean>

	<service interface="net.solarnetwork.settings.SettingSpecifierProviderFactory">
		<bean class="net.solarnetwork.settings.support.BasicSettingSpecifierProviderFactory">
			<property name="displayName" value="Counter Datum Source"/>
			<property name="factoryUid" value="com.example.solarnode.datum.counter"/>
			<property name="messageSource" ref="counterMessageSource"/>
		</bean>
	</service>

	<osgix:managed-service-factory factory-pid="com.example.solarnode.datum.counter" autowire-on-update="true">
		<osgix:interfaces>
			<beans:value>net.solarnetwork.node.job.ManagedJob</beans:value>
		</osgix:interfaces>
		<bean class="net.solarnetwork.node.job.SimpleManagedJob"
				init-method="serviceDidStartup" destroy-method="serviceDidShutdown">
			<argument>
				<bean class="net.solarnetwork.node.job.DatumDataSourcePollManagedJob">
					<property name="datumMetadataService" ref="datumMetadataService"/>
					<property name="datumQueue" ref="datumQueue"/>
					<property name="datumDataSource">
						<bean class="com.example.solarnode.filter.CounterDatumDataSource" init-method="startup">
							<property name="messageSource" ref="counterJobMessageSource"/>
							<property name="placeholderService" ref="placeholderService"/>
							<property name="step" value="2"/>
						</bean>
					</property>
				</bean>
			</argument>
			<argument value="0/30 * * * * ?"/>
			<property name="serviceProviderConfigurations">
				<map>
					<entry key="datumDataSource">
						<bean class="net.solarnetwork.node.job.SimpleServiceProviderConfiguration">
							<property name="interfaces">
								<list>
									<value>net.solarnetwork.node.service.DatumDataSource</value>
								</list>
							</property>
						</bean>
					</entry>
				</map>
			</property>
		</bean>
	</osgix:managed-service-factory>

	<!--
	 !!! Multi counter datum source
	 -->

	<bean id="multiCounterMessageSource" class="org.springframework.context.support.ResourceBundleMessageSource">
		<property name="basenames">
			<list>
				<value>com.example.solarnode.filter.MultiCounterDatumDataSource</value>
				<value>net.solarnetwork.node.service.support.DatumDataSourceSupport</value>
				<value>net.solarnetwork.service.support.BasicIdentifiable</value>
			</list>
		</property>
	</bean>

	<bean id="multiCounterJobMessageSource" class="net.solarnetwork.support.PrefixedMessageSource">
		<property name="prefix" value="multiDatumDataSource."/>
		<property name="delegate" ref="multiCounterMessageSource"/>
	</bean>

	<service interface="net.solarnetwork.settings.SettingSpecifierProviderFactory">
		<bean class="net.solarnetwork.settings.support.BasicSettingSpecifierProviderFactory">
			<property name="displayName" value="Multi Counter Datum Source"/>
			<property name="factoryUid" value="com.example.solarnode.datum.counter.multi"/>
			<property name="messageSource" ref="multiCounterMessageSource"/>
		</bean>
	</service>

	<osgix:managed-service-factory factory-pid="com.example.solarnode.datum.counter.multi" autowire-on-update="true">
		<osgix:interfaces>
			<beans:value>net.solarnetwork.node.job.ManagedJob</beans:value>
		</osgix:interfaces>
		<bean class="net.solarnetwork.node.job.SimpleManagedJob"
				init-method="serviceDidStartup" destroy-method="serviceDidShutdown">
			<argument>
				<bean class="net.solarnetwork.node.job.DatumDataSourcePollManagedJob">
					<property name="datumMetadataService" ref="datumMetadataService"/>
					<property name="datumQueue" ref="datumQueue"/>
					<property name="multiDatumDataSource">
						<bean class="com.example.solarnode.filter.MultiCounterDatumDataSource">
							<property name="messageSource" ref="multiCounterJobMessageSource"/>
							<property name="placeholderService" ref="placeholderService"/>
						</bean>
					</property>
				</bean>
			</argument>
			<argument value="20000"/>
			<property name="serviceProviderConfigurations">
				<map>
					<entry key="multiDatumDataSource">
						<bean class="net.solarnetwork.node.job.SimpleServiceProviderConfiguration">
							<property name="interfaces">
								<list>
									<value>net.solarnetwork.node.service.MultiDatumDataSource</value>
								</list>
							</property>
						</bean>
					</entry>
				</map>
			</property>
		</bean>
	</osgix:managed-service-factory>

	<!--
	 !!! Modbus counter datum source, which needs a service the simulator does not provide
	 -->

	<service interface="net.solarnetwork.settings.SettingSpecifierProviderFactory">
		<bean class="net.solarnetwork.settings.support.BasicSettingSpecifierProviderFactory">
			<property name="displayName" value="Modbus Counter Datum Source"/>
			<property name="factoryUid" value="com.example.solarnode.datum.modbus"/>
			<property name="messageSource" ref="counterMessageSource"/>
		</bean>
	</service>

	<osgix:managed-service-factory factory-pid="com.example.solarnode.datum.modbus" autowire-on-update="true">
		<osgix:interfaces>
			<beans:value>net.solarnetwork.node.job.ManagedJob</beans:value>
		</osgix:interfaces>
		<bean class="net.solarnetwork.node.job.SimpleManagedJob"
				init-method="serviceDidStartup" destroy-method="serviceDidShutdown">
			<argument>
				<bean class="net.solarnetwork.node.job.DatumDataSourcePollManagedJob">
					<property name="datumMetadataService" ref="datumMetadataService"/>
					<property name="datumQueue" ref="datumQueue"/>
					<property name="datumDataSource">
						<bean class="com.example.solarnode.filter.CounterDatumDataSource">
							<property name="messageSource" ref="counterJobMessageSource"/>
							<property name="modbusNetwork">
								<bean class="net.solarnetwork.common.osgi.service.DynamicServiceTracker">
									<argument ref="bundleContext"/>
									<property name="serviceClassName" value="net.solarnetwork.node.io.modbus.ModbusNetwork"/>
								</bean>
							</property>
						</bean>
					</property>
				</bean>
			</argument>
			<argument value="0 * * * * ?"/>
		</bean>
	</osgix:managed-service-factory>

</blueprint>
