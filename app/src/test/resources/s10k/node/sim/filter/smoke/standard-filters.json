    },
    "filterIds": [
     "split",
     "join"
    ]
   },
   {
    "id": "split",
    "factoryUid": "net.solarnetwork.node.datum.filter.std.split",
    "settings": {
     "uid": "Split",
     "sourceId": "^/meter/1$",
     "swallowInput": "false",
     "propertySourceMappingsCount": "1",
     "propertySourceMappings[0].key": "^voltage_(.*)$",
     "propertySourceMappings[0].value": "/meter/1/v"
    }
   },
   {
    "id": "join",
    "factoryUid": "net.solarnetwork.node.datum.filter.std.join",
    "settings": {
     "uid": "Join",
     "sourceId": "^/meter/1(/v)?$",
     "outputSourceId": "/joined",
     "coalesceThreshold": "2",
     "swallowInput": "false",
     "propertySourceMappingsCount": "2",
     "propertySourceMappings[0].key": "^/meter/1$",
     "propertySourceMappings[0].value": "{p}",
     "propertySourceMappings[1].key": "^/meter/1/v$",
     "propertySourceMappings[1].value": "v_{p}"
    }
   },
   {
    "id": "throttle",
    "factoryUid": "net.solarnetwork.node.datum.samplefilter.limiter",
    "settings": {
     "uid": "Throttle",
     "sourceId": "^/meter/1/v$",
     "frequencySeconds": "60"
    }
   },
   {
    "id": "unchanged",
    "factoryUid": "net.solarnetwork.node.datum.filter.std.unchanged",
    "settings": {
     "uid": "Unchanged",
     "sourceId": "^/joined$",
     "unchangedPublishMaxSeconds": "3599"
    }
   },
   {
    "id": "downsample",
    "factoryUid": "net.solarnetwork.node.datum.samplefilter.downsample",
    "settings": {
     "uid": "Downsample",
     "sourceId": "^/joined$",
     "sampleCount": "2"
    }
   },
   {
    "id": "timeout",
    "factoryUid": "net.solarnetwork.node.datum.filter.std.timeout",
    "settings": {
     "uid": "Timeout",
     "sourceId": "^/meter/1$",
     "outputSourceId": "/meter/1/timeout",
     "timeoutMillis": "90000"
    }
   }
  ]
