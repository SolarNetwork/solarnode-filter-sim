     "expressionConfigs[3].name": "datumSource",
     "expressionConfigs[3].datumPropertyTypeKey": "s",
     "expressionConfigs[3].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[3].expression": "datum.sourceId + ' ' + sourceId",
     "expressionConfigs[4].name": "hasAmps",
     "expressionConfigs[4].datumPropertyTypeKey": "i",
     "expressionConfigs[4].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[4].expression": "has('amps') ? 1 : 0",
     "expressionConfigs[5].name": "paramCount",
     "expressionConfigs[5].datumPropertyTypeKey": "i",
     "expressionConfigs[5].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[5].expression": "parameters.size() >= 0 ? 1 : 0",
     "expressionConfigs[6].name": "hasOff",
     "expressionConfigs[6].datumPropertyTypeKey": "i",
     "expressionConfigs[6].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[6].expression": "(hasOffset(1) ? 1 : 0) + (hasOffset(2) ? 10 : 0)",
     "expressionConfigs[7].name": "ampsDiff",
     "expressionConfigs[7].datumPropertyTypeKey": "i",
     "expressionConfigs[7].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[7].expression": "amps - offset(1).amps",
     "expressionConfigs[8].name": "latestDiff",
     "expressionConfigs[8].datumPropertyTypeKey": "i",
     "expressionConfigs[8].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[8].expression": "(amps * volts) - (latest('solar').amps * latest('solar').volts)",
     "expressionConfigs[9].name": "sumMatch",
     "expressionConfigs[9].datumPropertyTypeKey": "i",
     "expressionConfigs[9].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[9].expression": "sum(latestMatching('solar*').?[amps>1].![amps * volts])",
     "expressionConfigs[10].name": "sumSet",
     "expressionConfigs[10].datumPropertyTypeKey": "i",
     "expressionConfigs[10].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[10].expression": "sum(latestMatching({'solar1', 'solar2'}).![amps * volts])",
     "expressionConfigs[11].name": "othersCount",
     "expressionConfigs[11].datumPropertyTypeKey": "i",
     "expressionConfigs[11].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[11].expression": "latestOthersMatching('solar*').size() * 10 + selfAndLatestMatching('solar*').size()",
     "expressionConfigs[12].name": "hasLatestMatch",
     "expressionConfigs[12].datumPropertyTypeKey": "i",
     "expressionConfigs[12].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[12].expression": "(hasLatestMatching('solar*') ? 1 : 0) + (hasLatestMatching('nope*') ? 10 : 0) + (hasLatest('solar') ? 100 : 0) + (hasOffset('solar', 2) ? 1000 : 0)",
     "expressionConfigs[13].name": "sliceCount",
     "expressionConfigs[13].datumPropertyTypeKey": "i",
     "expressionConfigs[13].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[13].expression": "slice('solar', 0, 5).size()",
     "expressionConfigs[14].name": "offsetSource",
     "expressionConfigs[14].datumPropertyTypeKey": "i",
     "expressionConfigs[14].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[14].expression": "offset('solar', 1).amps",
     "expressionConfigs[15].name": "unfiltered",
     "expressionConfigs[15].datumPropertyTypeKey": "i",
     "expressionConfigs[15].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[15].expression": "unfilteredOffset(1).amps + unfilteredLatest('solar2').amps",
     "expressionConfigs[16].name": "unfilteredMatch",
     "expressionConfigs[16].datumPropertyTypeKey": "i",
     "expressionConfigs[16].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[16].expression": "unfilteredLatestMatching('solar*').size() * 10 + unfilteredSlice('solar', 0, 5).size()",
     "expressionConfigs[17].name": "bits",
     "expressionConfigs[17].datumPropertyTypeKey": "i",
     "expressionConfigs[17].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[17].expression": "and(xor(7, 2), shiftLeft(1, 3)) + or(1, 2) + andNot(7, 1) + shiftRight(8, 1) + (testBit(5, 0) ? 1 : 0)",
     "expressionConfigs[18].name": "narrowed",
     "expressionConfigs[18].datumPropertyTypeKey": "i",
     "expressionConfigs[18].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[18].expression": "narrow16(300) + narrow(5, 1)",
     "expressionConfigs[19].name": "math",
     "expressionConfigs[19].datumPropertyTypeKey": "i",
     "expressionConfigs[19].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[19].expression": "round(sqrt(pow(amps, 2)) + cbrt(27) + exp(0) + ceil(1.2) + floor(1.8) + mround(7, 5), 2)",
     "expressionConfigs[20].name": "interp",
     "expressionConfigs[20].datumPropertyTypeKey": "i",
     "expressionConfigs[20].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[20].expression": "interp(amps, 0, 10, 0, 100)",
     "expressionConfigs[21].name": "stats",
     "expressionConfigs[21].datumPropertyTypeKey": "i",
     "expressionConfigs[21].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[21].expression": "avg(group('^voltage_')) + max(1, 2) + min({3, 4}) + rms({3, 4}) + max({5, 6}) + sum({1, 2})",
     "expressionConfigs[22].name": "rounding",
     "expressionConfigs[22].datumPropertyTypeKey": "i",
     "expressionConfigs[22].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[22].expression": "wholePart(123.4567) + fracPart(1.25, 2) + scaled(1.5, 2) + up(1.2) + down(1.8) + roundUp(1.21, 1) + roundDown(1.29, 1) + ceil(7, 5) + floor(7, 5) + round(1.2345, 2)",
     "expressionConfigs[23].name": "numberValue",
     "expressionConfigs[23].datumPropertyTypeKey": "i",
     "expressionConfigs[23].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[23].expression": "numberValue('12.5')",
     "expressionConfigs[24].name": "sorted",
     "expressionConfigs[24].datumPropertyTypeKey": "i",
     "expressionConfigs[24].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[24].expression": "max(sort(group('^voltage_'), true))",
     "expressionConfigs[25].name": "regex",
     "expressionConfigs[25].datumPropertyTypeKey": "s",
     "expressionConfigs[25].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[25].expression": "regexReplace(sourceId, '^meter', 'METER')",
     "expressionConfigs[26].name": "regexMatch",
     "expressionConfigs[26].datumPropertyTypeKey": "i",
     "expressionConfigs[26].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[26].expression": "regexMatches(sourceId, '^meter/.*') ? 1 : 0",
     "expressionConfigs[27].name": "dateFmt",
     "expressionConfigs[27].datumPropertyTypeKey": "s",
     "expressionConfigs[27].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[27].expression": "formatDate(datePlus(date(2024, 11, 21, 13, 0), 1, 'days'), 'yyyy-MM-dd HH:mm', tz('UTC'))",
     "expressionConfigs[28].name": "dateTzEpoch",
     "expressionConfigs[28].datumPropertyTypeKey": "i",
     "expressionConfigs[28].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[28].expression": "epochSecs(dateTz(date('2024-11-21'), 'Pacific/Auckland'))",
     "expressionConfigs[29].name": "between",
     "expressionConfigs[29].datumPropertyTypeKey": "i",
     "expressionConfigs[29].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[29].expression": "daysBetween(date('2024-01-01'), date('2024-03-01')) + hoursBetween(date(2024, 1, 1, 0, 0), date(2024, 1, 1, 5, 0)) + minutesBetween(date(2024, 1, 1, 0, 0), date(2024, 1, 1, 0, 30))",
     "expressionConfigs[30].name": "betweenFrac",
     "expressionConfigs[30].datumPropertyTypeKey": "i",
     "expressionConfigs[30].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[30].expression": "round(monthsBetween(date('2024-01-01'), date('2024-07-01')) + yearsBetween(date('2024-01-01'), date('2025-01-01')), 2)",
     "expressionConfigs[31].name": "seconds",
     "expressionConfigs[31].datumPropertyTypeKey": "i",
     "expressionConfigs[31].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[31].expression": "secondsBetween(timestamp('2024-01-01T00:00:00Z'), timestamp('2024-01-01T00:01:00Z'))",
     "expressionConfigs[32].name": "dateFloor",
     "expressionConfigs[32].datumPropertyTypeKey": "s",
     "expressionConfigs[32].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[32].expression": "formatDate(dateFloor(timestamp('2024-01-01T10:17:00Z'), 'PT15M', 'UTC'), 'HH:mm', tz('UTC'))",
     "expressionConfigs[33].name": "dateTrunc",
     "expressionConfigs[33].datumPropertyTypeKey": "s",
     "expressionConfigs[33].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[33].expression": "formatDate(dateTruncate(date(2024, 1, 1, 10, 17), 'hours'), 'HH:mm', tz('UTC'))",
     "expressionConfigs[34].name": "datePlusDur",
     "expressionConfigs[34].datumPropertyTypeKey": "s",
     "expressionConfigs[34].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[34].expression": "formatDate(datePlus(date(2024, 1, 1, 10, 0), 'PT90M'), 'HH:mm', tz('UTC'))",
     "expressionConfigs[35].name": "nowFns",
     "expressionConfigs[35].datumPropertyTypeKey": "i",
     "expressionConfigs[35].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[35].expression": "now() != null && now('UTC') != null && timestamp() != null && today() != null && startOfDay() != null && nowTz() != null && nowTz('UTC') != null && today('UTC') != null && startOfDay('UTC') != null ? 1 : 0",
     "expressionConfigs[36].name": "localFns",
     "expressionConfigs[36].datumPropertyTypeKey": "s",
     "expressionConfigs[36].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[36].expression": "localDate(dateTz(date(2024, 1, 2, 3, 4), 'UTC')).toString() + ' ' + localTime(dateTz(date(2024, 1, 2, 3, 4), 'UTC')).toString() + ' ' + local(dateTz(date(2024, 1, 2, 3, 4), 'UTC')).toString()",
     "expressionConfigs[37].name": "timeFn",
     "expressionConfigs[37].datumPropertyTypeKey": "s",
     "expressionConfigs[37].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[37].expression": "time('13:45').toString()",
     "expressionConfigs[38].name": "chrono",
     "expressionConfigs[38].datumPropertyTypeKey": "s",
     "expressionConfigs[38].expressionServiceId": "net.solarnetwork.common.expr.spel.SpelExpressionService",
     "expressionConfigs[38].expression": "chronoUnit('hours').toString() + ' ' + duration('PT1H').toString() + ' ' + durationBetween(date(2024, 1, 1, 0, 0), date(2024, 1, 1, 2, 0)).toString()",
