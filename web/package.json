{
  "name": "solarnode-filter-sim-web",
  "version": "0.1.0",
  "private": true,
  "description": "SolarNode Filter Simulator web UI.",
  "license": "Apache-2.0",
  "author": {
    "name": "SolarNetwork Foundation",
    "email": "code@solarnetwork.net"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/main",
    "lint:fix": "eslint --fix src/main",
    "prettier": "prettier --config .prettierrc.json --check \"src/main/**/*.{ts,html,scss}\"",
    "prettier:write": "prettier --config .prettierrc.json --write \"src/main/**/*.{ts,html,scss}\"",
    "check": "npm run lint && npm run prettier"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@joint/core": "^4.3.3",
    "@lezer/highlight": "^1.2.5",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bootstrap": "^5.2.11",
    "eslint": "^10.13.0",
    "prettier": "3.9.10",
    "sass": "^1.105.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
